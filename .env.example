# TEMPLATE ONLY - this file is committed to the repo.
# Put real values in .env.local (gitignored), never here.
#
# Both values come from your Supabase project:
#   Project Settings -> Data API      -> Project URL
#   Project Settings -> API Keys      -> the publishable (anon) key
#
# Never use the project's secret key in this app. Vite inlines these into
# the browser bundle, so anything here is public. The publishable key is safe
# because row-level security is what protects the data.
#
# Without these the app runs in local-only mode: no sync between devices.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
